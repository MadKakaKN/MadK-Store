{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "AppSettings": {
    "SiteUrl": "https://madk.store"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/madk-store-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Jwt": {
    "Key": "MadK_Store_Super_Secret_Jwt_Signing_Key_2026_Enterprise_Security!@#$",
    "Issuer": "MadKStore",
    "Audience": "MadKStoreClient",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 14
  },
  "Storage": {
    "Provider": "Local",
    "UploadPath": "wwwroot/uploads",
    "BaseUrl": "/uploads",
    "MaxImageSizeBytes": 5242880,
    "MaxModel3DSizeBytes": 52428800,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "AllowedModel3DExtensions": [ ".glb", ".gltf" ],
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "BucketName": "madk-catalog",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "Vnpay": {
    "TmnCode": "MADKTEST",
    "HashSecret": "MADK_VNPAY_SECRET_KEY_FOR_LOCAL_TESTING_2026",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "http://localhost:5173/checkout/vnpay-return",
    "PaymentExpiryMinutes": 15
  },
  "OrderExpiration": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "EmailSettings": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "EnableSsl": false,
    "FromEmail": "noreply@madkstore.local",
    "FromName": "MadK Store",
    "MaxRetries": 3,
    "RetryBaseDelayMs": 500,
    "UseMock": false
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "QueueName": "madk_email_notifications"
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "Production",
    "TracesSampleRate": 1.0,
    "SendDefaultPii": false
  },
  "AllowedHosts": "*"
}

